# Copy to .env.local and fill in. See README.md for details.

# Server only. Never prefix with NEXT_PUBLIC_.
TMDB_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...), never a secret or service_role key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: API-Sports key (one key covers every sport)
SPORTS_API_KEY=
# Server only: YouTube Data API v3 key, restricted to that API
YOUTUBE_API_KEY=
